#!/usr/bin/env sh
# When a commit changed package.json, regenerate package-lock.json in the working tree and warn if it
# differs from what was committed. It never amends the commit. Skipped for other commits: it needs the network.
git diff-tree --no-commit-id --name-only -r HEAD | grep -qx package.json || exit 0
npm install --package-lock-only >/dev/null 2>&1
if ! git diff --quiet -- package-lock.json; then
  echo "post-commit: package-lock.json changed after install. Review and commit it." >&2
fi
